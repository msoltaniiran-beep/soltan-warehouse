  try {
    const [data, emps] = await Promise.all([api('GET', '/contracts'), api('GET', '/employees')]);
    const empMap  = Object.fromEntries(emps.map(e => [e.id, e.name]));
    const typeMap = { permanent:'دائمی', temporary:'موقت', part_time:'پاره وقت', project:'پروژه‌ای' };
    tbody.innerHTML = data.length ? data.map(c => `
      <tr>
