<!-- Toast container -->
<div id="toast-container" aria-live="polite" aria-atomic="true"></div>

<script>
/* ─── Config ──────────────────────────────────────────────────────────────── */
const API = (typeof WORKER_URL !== 'undefined' ? WORKER_URL : '').replace(/\/$/, '');

/* ─── Utilities ───────────────────────────────────────────────────────────── */
const $ = (sel, ctx = document) => ctx.querySelector(sel);
const $$ = (sel, ctx = document) => [...ctx.querySelectorAll(sel)];
const fmt = n => Number(n).toLocaleString('fa-IR');

function toast(msg, type = 'info') {
  const el = document.createElement('div');
  el.className = `toast toast--${type}`;
  el.textContent = msg;
  $('#toast-container').appendChild(el);
  setTimeout(() => el.remove(), 3500);
}

async function api(method, path, body) {
  const opts = { method, headers: { 'Content-Type': 'application/json' } };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(API + path, opts);
  if (!res.ok) throw new Error(await res.text());
  return res.status === 204 ? null : res.json();
}

function statusBadge(status) {
  const map = {
    active:    ['success', 'فعال'],
    inactive:  ['warning', 'غیرفعال'],
    approved:  ['success', 'تأیید'],
    pending:   ['warning', 'در انتظار'],
    rejected:  ['danger',  'رد شده'],
    expired:   ['warning', 'منقضی'],
    terminated:['danger',  'فسخ'],
    permanent: ['info',    'دائمی'],
    temporary: ['info',    'موقت'],
    part_time: ['info',    'پاره وقت'],
    project:   ['info',    'پروژه‌ای'],
    annual:    ['info',    'سالانه'],
    sick:      ['warning', 'استعلاجی'],
    emergency: ['danger',  'اضطراری'],
    unpaid:    ['warning', 'بدون حقوق'],
  };
  const [cls, label] = map[status] || ['info', status];
  return `<span class="badge badge--${cls}">${label}</span>`;
}

/* ─── Navigation ──────────────────────────────────────────────────────────── */
$$('.nav-item').forEach(btn => {
  btn.addEventListener('click', () => {
    $$('.nav-item').forEach(b => { b.classList.remove('active'); b.removeAttribute('aria-current'); });
    btn.classList.add('active'); btn.setAttribute('aria-current', 'page');
    $$('.section').forEach(s => s.classList.remove('active'));
    $(`#section-${btn.dataset.section}`).classList.add('active');
    if (btn.dataset.section === 'employees') loadEmployees();
    if (btn.dataset.section === 'contracts') loadContracts();
    if (btn.dataset.section === 'leaves')    loadLeaves();
  });
});

/* ─── Modal helpers ───────────────────────────────────────────────────────── */
function openModal(id)id) { $(`#${id}`).classList.remove('open'); }

documenid}`).classList.add('open'); }
function closeModal(id) { $(`#${id}`).classList.remove('open'); }

document.addEventListener('click', e => {
  if (e.target.dataset.close) closeModal(e.target.dataset.close);
  if (e.target.classList.contains('modal-backdrop')) closeModal(e.target.id);
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') $$('.modal-backdrop.open').forEach(m => closeModal(m.id));
});

/* ─── Validation ──────────────────────────────────────────────────────────── */
function validate(form) {
  let ok = true;
  form.querySelectorAll('[required]').forEach(el => {
    if (!el.value.trim()) { el.classList.add('error'); ok = false; }
    else el.classList.remove('error');
  });
  return ok;
}

/* ─── Employee selects ────────────────────────────────────────────────────── */
async function populateEmployeeSelects() {
  let emps = [];
  try { emps = await api('GET', '/employees'); } catch { return; }
  ['contract-employee', 'leave-employee'].forEach(id => {
    const sel = document.getElementById(id);
    const cur = sel.value;
    sel.innerHTML = '<option value="">انتخاب کنید</option>';
    emps.forEach(e => {
      const opt = document.createElement('option');
      opt.value = e.id; opt.textContent = e.name;
      sel.appendChild(opt);
    });
    sel.value = cur;
  });
}

/* ─── Employees ───────────────────────────────────────────────────────────── */
async function loadEmployees() {
  const tbody = $('#employees-tbody');
  tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--text-muted)">در حال بارگذاری…</td></tr>`;
  try {
    const data = await api('GET', '/employees');
    const active = data.filter(e => e.status === 'active').length;
    const totalSalary = data.reduce((s, e) => s + Number(e.salary || 0), 0);
    $('#stat-emp-count').textContent  = data.length;
    $('#stat-emp-active').textContent = active;
    $('#stat-emp-salary').textContent = fmt(totalSalary);

    tbody.innerHTML = data.length ? data.map(e => `
      <tr>
        <td>${e.name}</td>
        <td style="font-variant-numeric:tabular-nums">${e.national_id}</td>
        <td>${e.department || '—'}</td>
        <td style="font-variant-numeric:tabular-nums">${fmt(e.salary)}</td>
        <td>${statusBadge(e.status)}</td>
        <td>
          <button class="btn btn--ghost btn--sm"
                  data-edit-emp="${e.id}"
                  data-emp='${JSON.stringify(e).replace(/'/g, '&#39;')}'>ویرایش</button>
          <button class="btn btn--danger-ghost btn--sm"
                  data-del-emp="${e.id}" style="margin-right:4px">حذف</button>
        </td>
      </tr>`).join('')
    : `<tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--text-muted)">کارمندی ثبت نشده است.</td></tr>`;
  } catch (err) {
    tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--danger)">خطا در بارگذاری: ${err.message}</td></tr>`;
  }
}

$('#btn-add-employee').addEventListener('click', () => {
  $('#form-employee').reset();
  $('#form-employee').dataset.editId = '';
  $('#modal-employee-title').textContent = 'افزودن کارمند';
  openModal('modal-employee');
});

$('#form-employe => {
  e.preventDefault();
  if (!validate(e.target)) return;
  const body = Object.fromEntries(new FormData(e.target). FormData(e.target).entries());
  const editId = e.target.dataset.editId;
  try {
    if (editId) await api('PUT', `/employees/${editId}`, body);
    else        await api('POST', '/employees', body);
    toast(editId ? 'اطلاعات کارمند ویرایش شد' : 'کارمند با موفقیت اضافه شد', 'success');
    closeModal('modal-employee');
    loadEmployees();
  } catch (err) { toast('خطا: ' + err.message, 'danger'); }
});

/* ─── Delegated edit / delete ─────────────────────────────────────────────── */
document.addEventListener('click', async e => {
  const t = e.target;

  if (t.dataset.editEmp) {
    const emp = JSON.parse(t.dataset.emp);
    const form = $('#form-employee');
    form.dataset.editId = emp.id;
    $('#modal-employee-title').textContent = 'ویرایش کارمند';
    Object.entries(emp).forEach(([k, v]) => { const el = form.elements[k]; if (el) el.value = v ?? ''; });
    openModal('modal-employee');
  }

  if (t.dataset.delEmp) {
    if (!confirm('آیا از حذف این کارمند مطمئن هستید؟')) return;
    try {
      await api('DELETE', `/employees/${t.dataset.delEmp}`);
      toast('کارمند حذف شد', 'success');
      loadEmployees();
    } catch (err) { toast('خطا: ' + err.message, 'danger'); }
  }

  if (t.dataset.editContract) {
    const c = JSON.parse(t.dataset.contract);
    const form = $('#form-contract');
    form.dataset.editId = c.id;
    $('#modal-contract-title').textContent = 'ویرایش قرارداد';
    await populateEmployeeSelects();
    Object.entries(c).forEach(([k, v]) => { const el = form.elements[k]; if (el) el.value = v ?? ''; });
    openModal('modal-contract');
  }

  if (t.dataset.delContract) {
    if (!confirm('حذف این قرارداد؟')) return;
    try {
      await api('DELETE', `/contracts/${t.dataset.delContract}`);
      toast('قرارداد حذف شد', 'success');
      loadContracts();
    } catch (err) { toast('خطا: ' + err.message, 'danger'); }
  }

  if (t.dataset.editLeave) {
    const l = JSON.parse(t.dataset.leave);
    const form = $('#form-leave');
    form.dataset.editId = l.id;
    $('#modal-leave-title').textContent = 'ویرایش مرخصی';
    await populateEmployeeSelects();
    Object.entries(l).forEach(([k, v]) => { const el = form.elements[k]; if (el) el.value = v ?? ''; });
    openModal('modal-leave');
  }

  if (t.dataset.delLeave) {
    if (!confirm('حذف این مرخصی؟')) return;
    try {
      await api('DELETE', `/leaves/${t.dataset.delLeave}`);
      toast('مرخصی حذف شد', 'success');
      loadLeaves();
    } catch (err) { toast('خطا: ' + err.message, 'danger'); }
  }
});

/* ─── Contracts ───────────────────────────────────────────────────────────── */
async function loadContracts() {
  const tbody = $('#contracts-tbody');
