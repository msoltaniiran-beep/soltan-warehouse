<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>سامانه اتوماسیون منابع انسانی</title>
  <style>
    /* ── Token system ─────────────────────────────────────────── */
    :root {
      --n-0:  oklch(98% 0.005 250);
      --n-1:  oklch(95% 0.008 250);
      --n-2:  oklch(90% 0.010 250);
      --n-3:  oklch(80% 0.012 250);
      --n-4:  oklch(60% 0.014 250);
      --n-5:  oklch(45% 0.014 250);
      --n-6:  oklch(30% 0.012 250);
      --n-7:  oklch(18% 0.010 250);
      --n-8:  oklch(13% 0.008 250);

      --a-base:   oklch(55% 0.18 240);
      --a-light:  oklch(68% 0.16 240);
      --a-dark:   oklch(42% 0.18 240);
      --a-bg:     oklch(96% 0.04 240);

      --success:  oklch(55% 0.15 150);
      --warning:  oklch(62% 0.17 75);
      --danger:   oklch(54% 0.20 25);
      --info:     oklch(58% 0.16 220);

      --surface:        var(--n-0);
      --surface-raised: #fff;
      --border:         var(--n-2);
      --text-muted:     var(--n-4);
      --text-body:      var(--n-7);
      --text-heading:   var(--n-8);

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 16px;

      --shadow-sm: 0 1px 3px oklch(13% 0.01 250 / 0.10);
      --shadow-md: 0 4px 12px oklch(13% 0.01 250 / 0.12);

      --space-1: 4px;
      --space-2: 8px;
      --space-3: 12px;
      --space-4: 16px;
      --space-5: 24px;
      --space-6: 32px;
      --space-7: 48px;

      --font: 'Segoe UI', Tahoma, sans-serif;
      --fs-xs: 0.75rem;
      --fs-sm: 0.875rem;
      --fs-base: 1rem;
      --fs-lg: 1.125rem;
      --fs-xl: 1.375rem;
      --fs-2xl: 1.75rem;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --n-0:  oklch(14% 0.010 250);
        --n-1:  oklch(18% 0.012 250);
        --n-2:  oklch(25% 0.012 250);
        --n-3:  oklch(38% 0.012 250);
        --n-4:  oklch(55% 0.010 250);
        --n-5:  oklch(70% 0.008 250);
        --n-6:  oklch(82% 0.006 250);
        --n-7:  oklch(92% 0.005 250);
        --n-8:  oklch(97% 0.004 250);

        --a-base:  oklch(62% 0.17 240);
        --a-light: oklch(72% 0.14 240);
        --a-dark:  oklch(50% 0.18 240);
        --a-bg:    oklch(22% 0.06 240);

        --surface:        var(--n-0);
        --surface-raised: var(--n-1);
        --border:         var(--n-2);
        --text-muted:     var(--n-4);
        --text-body:      var(--n-7);
        --text-heading:   var(--n-8);
      }
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font);
      font-size: var(--fs-base);
      line-height: 1.6;
      color: var(--text-body);
      background: var(--surface);
      min-height: 100vh;
    }

    /* ── Layout ───────────────────────────────────────────────── */
    .app { display: grid; grid-template-columns: 240px 1fr; grid-template-rows: 56px 1fr; min-height: 100vh; }

    /* ── Topbar ───────────────────────────────────────────────── */
    .topbar {
      grid-column: 1 / -1;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 var(--space-5);
      background: var(--surface-raised);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      gap: var(--space-4);
    }
    .topbar__brand { font-size: var(--fs-lg); font-weight: 700; color: var(--a-base); letter-spacing: -0.01em; }
    .topbar__user { display: flex; align-items: center; gap: var(--space-2); font-size: var(--fs-sm); color: var(--text-muted); }
    .avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--a-bg); color: var(--a-base);
      display: grid; place-items: center; font-weight: 700; font-size: var(--fs-xs);
    }

    /* ── Sidebar ──────────────────────────────────────────────── */
    .sidebar {
      background: var(--surface-raised);
      border-left: 1px solid var(--border);
      padding: var(--space-5) 0;
      display: flex; flex-direction: column; gap: var(--space-1);
    }
    .nav-item {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-3) var(--space-5);
      cursor: pointer;
      font-size: var(--fs-sm); color: var(--text-body);
      border: none; background: none; width: 100%; text-align: right;
      transition: background 150ms ease, color 150ms ease;
      border-radius: 0;
    }
    .nav-item:hover { background: var(--n-1); color: var(--a-base); }
    .nav-item:focus-visible { outline: 2px solid var(--a-base); outline-offset: -2px; }
    .nav-item.active { background: var(--a-bg); color: var(--a-base); font-weight: 600; }
    .nav-item .icon { font-size: 1.1rem; flex-shrink: 0; }

    /* ── Main ─────────────────────────────────────────────────── */
    .main { padding: var(--space-6); overflow-y: auto; }

    /* ── Section ──────────────────────────────────────────────── */
    .section { display: none; }
    .section.active { display: block; }

    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: var(--space-5);
      flex-wrap: wrap; gap: var(--space-3);
    }
    .section-title { font-size: var(--fs-xl); font-weight: 700; color: var(--text-heading); }

    /* ── Stats row ────────────────────────────────────────────── */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6); }
    .stat-card {
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-5);
      box-shadow: var(--shadow-sm);
    }
    .stat-card__label { font-size: var(--fs-xs); color: var(--text-muted); margin-bottom: var(--space-1); }
    .stat-card__value { font-size: var(--fs-2xl); font-weight: 700; color: var(--a-base); font-variant-numeric: tabular-nums; }

    /* ── Card ─────────────────────────────────────────────────── */
    .card {
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .card-body { padding: var(--space-5); }

    /* ── Table ────────────────────────────────────────────────── */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
    thead th {
      position: sticky; top: 0;
      background: var(--n-1);
      padding: var(--space-3) var(--space-4);
      text-align: right;
      font-weight: 600; color: var(--text-heading);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    tbody tr { transition: background 120ms ease; }
    tbody tr:hover { background: var(--n-1); }
    tbody td { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); color: var(--text-body); }
    tbody tr:last-child td { border-bottom: none; }

    /* ── Badge ────────────────────────────────────────────────── */
    .badge {
      display: inline-flex; align-items: center; gap: var(--space-1);
      padding: 2px var(--space-2);
      border-radius: var(--radius-sm);
      font-size: var(--fs-xs); font-weight: 600;
      white-space: nowrap;
    }
    .badge--success { background: oklch(92% 0.08 150); color: oklch(35% 0.15 150); }
    .badge--warning { background: oklch(94% 0.08 75);  color: oklch(38% 0.17 75); }
    .badge--danger  { background: oklch(93% 0.08 25);  color: oklch(40% 0.18 25); }
    .badge--info    { background: oklch(92% 0.07 220);  color: oklch(40% 0.16 220); }

    /* ── Button ───────────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
      font-size: var(--fs-sm); font-weight: 600;
      border: 1px solid transparent;
      cursor: pointer;
      transition: background 150ms ease, box-shadow 150ms ease, transform 100ms ease;
      min-height: 36px;
    }
    .btn:focus-visible { outline: 2px solid var(--a-base); outline-offset: 2px; }
    .btn:active { transform: scale(0.98); }
    .btn--primary { background: var(--a-base); color: #fff; }
    .btn--primary:hover { background: var(--a-dark); box-shadow: var(--shadow-sm); }
    .btn--ghost { background: transparent; color: var(--a-base); border-color: var(--a-base); }
    .btn--ghost:hover { background: var(--a-bg); }
    .btn--danger-ghost { background: transparent; color: var(--danger); border-color: var(--danger); }
    .btn--danger-ghost:hover { background: oklch(96% 0.04 25); }
    .btn--sm { padding: var(--space-1) var(--space-3); min-height: 28px; font-size: var(--fs-xs); }

    /* ── Form ─────────────────────────────────────────────────── */
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4) var(--space-5); }
    .form-field { display: flex; flex-direction: column; gap: var(--space-1); }
    .form-field label { font-size: var(--fs-sm); font-weight: 600; color: var(--text-heading); }
    .form-field input,
    .form-field select,
    .form-field textarea {
      padding: var(--space-2) var(--space-3);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: var(--fs-sm); font-family: var(--font);
      color: var(--text-body); background: var(--surface);
      transition: border-color 150ms ease, box-shadow 150ms ease;
      min-height: 38px;
    }
    .form-field input:focus,
    .form-field select:focus,
    .form-field textarea:focus {
      outline: none;
      border-color: var(--a-base);
      box-shadow: 0 0 0 3px oklch(55% 0.18 240 / 0.15);
    }
    .form-field input.error { border-color: var(--danger); }
    .form-field .field-error { font-size: var(--fs-xs); color: var(--danger); display: none; }
    .form-field input.error + .field-error { display: block; }
    .form-actions { display: flex; gap: var(--space-3); margin-top: var(--space-5); justify-content: flex-end; }

    /* ── Modal ────────────────────────────────────────────────── */
    .modal-backdrop {
      display: none; position: fixed; inset: 0;
      background: oklch(13% 0.01 250 / 0.45);
      z-index: 100;
      place-items: center;
    }
    .modal-backdrop.open { display: grid; }
    .modal {
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      width: min(520px, 90vw);
      max-height: 90vh; overflow-y: auto;
      padding: var(--space-6);
      animation: modal-in 180ms ease;
    }
    @keyframes modal-in { from { opacity:0; transform:translateY(-12px); } to { opacity:1; transform:translateY(0); } }
    .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
    .modal-title { font-size: var(--fs-lg); font-weight: 700; color: var(--text-heading); }
    .modal-close { background: none; border: none; cursor: pointer; color: var(--text-muted); font-size: 1.4rem; line-height: 1; padding: var(--space-1); border-radius: var(--radius-sm); }
    .modal-close:hover { color: var(--text-body); background: var(--n-1); }
    .modal-close:focus-visible { outline: 2px solid var(--a-base); }

    /* ── Toast ────────────────────────────────────────────────── */
    #toast-container { position: fixed; bottom: var(--space-5); left: var(--space-5); z-index: 200; display: flex; flex-direction: column; gap: var(--space-2); }
    .toast {
      background: var(--n-8); color: var(--n-0);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
      font-size: var(--fs-sm); box-shadow: var(--shadow-md);
      display: flex; align-items: center; gap: var(--space-2);
      animation: toast-in 200ms ease;
      max-width: 320px;
    }
    @keyframes toast-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .toast--success { background: oklch(40% 0.15 150); color: #fff; }
    .toast--danger  { background: oklch(42% 0.18 25);  color: #fff; }

    /* ── Loading skeleton ─────────────────────────────────────── */
    .skeleton { background: var(--n-2); border-radius: var(--radius-sm); animation: pulse 1.4s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.45} }

    /* ── Responsive ───────────────────────────────────────────── */
    @media (max-width: 720px) {
      .app { grid-template-columns: 1fr; grid-template-rows: 56px auto 1fr; }
      .sidebar { grid-row: 2; flex-direction: row; overflow-x: auto; padding: var(--space-2) var(--space-3); border-left: none; border-bottom: 1px solid var(--border); }
      .nav-item { flex-direction: column; gap: var(--space-1); padding: var(--space-2) var(--space-3); font-size: var(--fs-xs); min-width: 72px; }
      .main { padding: var(--space-4); }
    }
  </style>

  <!-- Topbar -->
  <header class="topbar">
    <span class="topbar__brand">HR ات اتوماسیون</span>
    <div class="topbar__user">
      <span>محمد سلطانی</span>
      <div class="avatar" aria-hidden="true">م</div>
    </div>
  </header>

  <!-- Sidebar -->
  <nav class="sidebar" aria-label="منوی اصلی">
    <button class="nav-item active" data-section="employees" aria-current="page">
      <span class="icon" aria-hidden="true">👤</span> کارمندان
    </button>
    <button class="nav-item" data-section="contracts">
      <span class="icon" aria-hidden="true">📄</span> قراردادها
    </button>
    <button class="nav-item" data-section="leaves">
      <span class="icon" aria-hidden="true">🗓</span> مرخصی‌ها
    </button>
  </nav>

  <!-- Main content -->
  <main class="main">

    <!-- ── Employees ── -->
    <section class="section active" id="section-employees" aria-labelledby="title-employees">
      <div class="section-header">
        <h1 class="section-title" id="title-employees">کارمندان</h1>
        <button class="btn btn--primary" id="btn-add-employee">+ افزودن کارمند</button>
      </div>
      <div class="stats" id="employee-stats">
        <div class="stat-card"><div class="stat-card__label">تعداد کارمندان</div><div class="stat-card__value" id="stat-emp-count">—</div></div>
        <div class="stat-card"><div class="stat-card__label">فعال</div><div class="stat-card__value" id="stat-emp-active" style="color:var(--succcard"><div class="stat-card__label">مجموع حموع حقوق (ریال)</div><div class="stat-card__value" id="stat-emp-salary">—</div></div>
      </div>
      <div class="card">
        <div class="table-wrap">
          <table aria-label="جدول کارمندان">
            <thead>
              <tr>
                <th>نام</th><th>کد ملی</th><th>بخش</th><th>حقوق (ریال)</th><th>وضعیت</th><th>عملیات</th>
              </tr>
            </thead>
            <tbody id="employees-tbody">
              <tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--text-muted)">در حال بارگذاری…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── Contracts ── -->
    <section class="section" id="section-contracts" aria-labelledby="title-contracts">
      <div class="section-header">
        <h1 class="section-title" id="title-contracts">قراردادها</h1>
        <button class="btn btn--primary" id="btn-add-contract">+ افزودن قرارداد</button>
      </div>
      <div class="card">
        <div class="table-wrap">
          <table aria-label="جدول قراردادها">
            <thead>
              <tr><th>کارمند</th><th>نوع قرارداد</th><th>تاریخ شروع</th><th>تاریخ پایان</th><th>وضعیت</th><th>عملیات</th></tr>
            </thead>
            <tbody id="contracts-tbody">
              <tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--text-muted)">در حال بارگذاری…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ── Leaves ── -->
    <section class="section" id="section-leaves" aria-labelledby="title-leaves">
      <div class="section-header">
        <h1 class="section-title" id="title-leaves">مرخصی‌ها</h1>
        <button class="btn btn--primary" id="btn-add-leave">+ ثبت مرخصی</button>
      </div>
      <div class="card">
        <div class="table-wrap">
          <table aria-label="جدول مرخصی‌ها">
            <thead>
              <tr><th>کارمند</th><th>نوع</th><th>از تاریخ</th><th>تا تاریخ</th><th>وضعیت</th><th>عملیات</th></tr>
            </thead>
            <tbody id="leaves-tbody">
              <tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--text-muted)">در حال بارگذاری…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>
</div>

<!-- ── Modal: Employee ── -->
<div class="modal-backdrop" id="modal-employee" role="dialog" aria-modal="true" aria-labelledby="modal-employee-title">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="modal-employee-title">افزودن کارمند</span>
      <button class="modal-close" aria-label="بستن" data-close="modal-employee">×</button>
    </div>
    <form id="form-employee" novalidate>
      <div class="form-grid">
        <div class="form-field">
          <label for="emp-name">نام و نام خانوادگی *</label>
          <input type="text" id="emp-name" name="name" required autocomplete="name" />
          <span class="field-error">نام الزامی است</span>
        </div>
        <div class="form-field">
          <label for="emp-national-id">کد ملی *</label>
          <input type="text" id="emp-national-id" name="national_id" required maxlength="10" pattern="\d{10}" />
          <span class="field-error">کد ملی ۱۰ رقمی الزامی است</span>
        </div>
        <div class="form-field">
          <label for="emp-department">بخش</label>
          <select id="emp-department" name="department">
            <option value="">انتخاب کنید</option>
            <option>مالی</option><option>فروش</option><option>منابع انسانی</option><option>فناوری اطلاعات</option><option>تولید</option><option>انبار</option>
          </select>
        </div>
        <div class="form-field">
          <label for="emp-salary">حقوق پایه (ریال) *</label>
          <input type="number" id="emp-salary" name="salary" required min="0" />
          <span class="field-error">حقوق الزامی است</span>
        </div>
        <div class="form-field">
          <label for="emp-phone">شماره تماس</label>
          <input type="tel" id="emp-phone" name="phone" />
        </div>
        <div class="form-field">
          <label for="emp-status">وضعیت</label>
          <select id="emp-status" name="status">
            <option value="active">فعال</option>
            <option value="inactive">غیرفعال</option>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn--ghost" data-close="modal-employee">انصراف</button>
        <button type="submit" class="btn btn--primary">ذخیره</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Modal: Contract ── -->
<div class="modal-backdrop" id="modal-contract" role="dialog" aria-modal="true" aria-labelledby="modal-contract-title">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title" id="modal-contract-title">افزودن قرارداد</span>
      <button class="modal-close" aria-label="بستن" data-close="modal-contract">×</button>
    </div>
    <form id="form-contract" novalidate>
      <div class="form-grid">
        <div class="form-field">
          <label for="contract-employee">کارمند *</label>
          <select id="contract-employee" name="employee_id" required>
            <option value="">انتخاب کنید</option>
          </select>
          <span class="field-error">انتخاب کارمند الزامی است</span>
        </div>
        <div class="form-field">
          <label for="contract-type">نوع قرارداد *</label>
          <select id="contract-type" name="contract_type" required>
            <option value="">انتخاب کنید</option>
            <option value="permanent">دائمی</option>
            <option value="temporary">موقت</option>
            <option value="part_time">پاره وقت</option>
            <option value="project">پروژه‌ای</option>
          </select>
          <span class="field-error">نوع قرارداد الزامی است</span>
        </div>
        <div class="form-field">
          <label for="contract-start">تاریخ شروع *</label>
          <input type="date" id="contract-start" name="start_date" required />
          <span class="field-error">تاریخ شروع الزامی است</span>
        </div>
        <div class="form-field">
          <label for="contract-end">تاریخ پایان</label>
          <input type="date" id="contract-end" name="end_date" />
        </div>
        <div class="form-field">
          <label for="contract-amount">مبلغ (ریال)</label>
          <input type="number" id="contract-amount" name="amount" min="0" />
        </div>
        <div class="form-field">
          <label for="contract-status">وضعیت</label>
          <select id="contract-status" name="status">
            <option value="active">فعال</option>
            <option value="expired">منقضی</option>
            <option value="terminated">فسخ شده</option>
          </select>
        </div>
      </div>
      <div class="form-actions">
