    : `<tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--text-muted)">قراردادی ثبت نشده است.</td></tr>`;
  } catch (err) {
    tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:var(--space-6);color:var(--danger)">خطا: ${err.message}</td></tr>`;
  }
}

